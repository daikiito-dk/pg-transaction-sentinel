# Copy to .env on the server and fill in POSTGRES_PASSWORD with the output of
# `openssl rand -hex 24` (letters and digits only, because it is embedded in the
# database URL). Docker Compose refuses to start while it is empty.
# サーバー上で .env にコピーし、POSTGRES_PASSWORD に `openssl rand -hex 24` の
# 出力を入れてください（DB 接続 URL に埋め込むため英数字のみ）。空のままでは
# Docker Compose は起動しません。
POSTGRES_USER=aml
POSTGRES_PASSWORD=
POSTGRES_DB=aml_db

# Domain for automatic HTTPS, or ":80" for plain HTTP by IP address
# 自動 HTTPS 用のドメイン。IP アドレスの HTTP で公開する場合は ":80"
SITE_ADDRESS=aml-demo.trustyon.jp

# Disable expensive operations such as re-scoring / 再スコアリングなど負荷の高い操作を無効化
PUBLIC_DEMO=true
