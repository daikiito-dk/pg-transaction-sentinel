# Local settings for the optional demo tools (docs/TOOLS.md).
# オプションのデモツール用ローカル設定（docs/TOOLS.md 参照）。
#
# Copy this file to `.env.tools` and fill in values ONLY on your own machine.
# `.env.tools` is excluded from git (see .gitignore): never commit credentials.
# このファイルを `.env.tools` にコピーし、自分のマシンでのみ値を入力して
# ください。`.env.tools` は git 管理対象外です。認証情報をコミットしないで
# ください。
#
#   cp .env.tools.example .env.tools

# --- Kafka transfer-message monitor / Kafka 振込メッセージ監視 --------------- #
# Explicit admin opt-in for the real (live) monitor. While false, the monitor
# scene only offers the offline sample mode and never opens a Kafka connection.
# ライブ監視の明示的な有効化。false の間はオフラインのサンプルモードのみで、
# Kafka への接続は行いません。
KAFKA_ENABLED=false

# Loopback-only broker address. Any non-loopback host is refused, and the demo
# UI never lets a visitor type a broker URL.
# ブローカーはループバックのみ。UI で任意のブローカー URL を入力できません。
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=banking.transfers

# --- Keycloak test-user provisioning / Keycloak テストユーザー設定 ---------- #
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_ADMIN=demo-admin

# Required only to run the Keycloak profile of docker-compose.tools.yml.
# Generate a value locally and keep it out of git:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Keycloak 起動にのみ必須。下記は空欄のままコミットされます。
KEYCLOAK_ADMIN_PASSWORD=

# --- Local tool writes / ツール書き込みの明示的な許可 ----------------------- #
# Every tool write (demo_sandbox inserts, Keycloak provisioning, file exports,
# test-message producing) is refused while PUBLIC_DEMO=true. Setting
# LOCAL_TOOL_WRITES=true is the additional explicit opt-in for local writes.
# すべてのツール書き込みは PUBLIC_DEMO=true で拒否されます。
# LOCAL_TOOL_WRITES=true はローカル書き込みの追加の明示的な許可です。
LOCAL_TOOL_WRITES=false
